# ---- .NET ----
backend/**/bin/
backend/**/obj/
*.user
appsettings.*.local.json
# contains SMTP credentials — keep secrets out of git
backend/**/appsettings.Development.json
# uploaded user content (keep the folder via .gitkeep, ignore the files)
backend/**/wwwroot/uploads/profile/*
!backend/**/wwwroot/uploads/profile/.gitkeep

