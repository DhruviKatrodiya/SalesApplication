<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvGreeting"
                style="@style/Text.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/Text.CardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <!-- Items in Catalog -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/kpiCard" android:layout_row="0" android:layout_column="0">
                    <LinearLayout style="@style/kpiInner">
                        <ImageView style="@style/kpiIcon" android:src="@drawable/ic_catalog" app:tint="@color/text_primary" />
                        <TextView android:id="@+id/vItems" style="@style/Text.CardValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="0" />
                        <TextView style="@style/Text.CardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Items in Catalog" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Low Stock -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/kpiCard" android:layout_row="0" android:layout_column="1">
                    <LinearLayout style="@style/kpiInner">
                        <ImageView style="@style/kpiIcon" android:src="@drawable/ic_warning" app:tint="@color/danger" />
                        <TextView android:id="@+id/vLowStock" style="@style/Text.CardValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="0" />
                        <TextView style="@style/Text.CardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Low Stock (≤ 10)" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Customers -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/kpiCard" android:layout_row="1" android:layout_column="0">
                    <LinearLayout style="@style/kpiInner">
                        <ImageView style="@style/kpiIcon" android:src="@drawable/ic_customers" app:tint="@color/text_primary" />
                        <TextView android:id="@+id/vCustomers" style="@style/Text.CardValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="0" />
                        <TextView style="@style/Text.CardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Customers" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pending Orders -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/kpiCard" android:layout_row="1" android:layout_column="1">
                    <LinearLayout style="@style/kpiInner">
                        <ImageView style="@style/kpiIcon" android:src="@drawable/ic_pending" app:tint="@color/accent" />
                        <TextView android:id="@+id/vPending" style="@style/Text.CardValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="0" />
                        <TextView style="@style/Text.CardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending Orders" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Total Sales -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/kpiCard" android:layout_row="2" android:layout_column="0">
                    <LinearLayout style="@style/kpiInner">
                        <ImageView style="@style/kpiIcon" android:src="@drawable/ic_payments" app:tint="@color/text_primary" />
                        <TextView android:id="@+id/vSales" style="@style/Text.CardValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="₹0" />
                        <TextView style="@style/Text.CardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Sales" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Outstanding Balance -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/kpiCard" android:layout_row="2" android:layout_column="1">
                    <LinearLayout style="@style/kpiInner">
                        <ImageView style="@style/kpiIcon" android:src="@drawable/ic_wallet" app:tint="@color/danger" />
                        <TextView android:id="@+id/vOutstanding" style="@style/Text.CardValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="₹0" />
                        <TextView style="@style/Text.CardLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Outstanding Balance" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewOrder"
                    style="@style/Widget.SalesApp.AddButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="New Order" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDispatch"
                    style="@style/Widget.SalesApp.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_dispatch"
                    app:iconTint="@color/primary"
                    android:text="Dispatch" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddCustomer"
                style="@style/Widget.SalesApp.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:icon="@drawable/ic_add_customer"
                app:iconTint="@color/primary"
                android:text="Add Customer" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
