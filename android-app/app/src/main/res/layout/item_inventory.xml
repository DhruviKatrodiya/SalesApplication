<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/StatusChip" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvStock"
                style="@style/NumberPill"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvTruck"
                style="@style/NumberPill"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:id="@+id/tvUnit" />

            <ImageButton
                android:id="@+id/btnHistory"
                style="@style/Widget.SalesApp.IconButton"
                android:src="@drawable/ic_history"
                android:contentDescription="Price history" />

            <ImageButton
                android:id="@+id/btnMovements"
                style="@style/Widget.SalesApp.IconButton"
                android:src="@drawable/ic_payments"
                android:contentDescription="Stock movements" />

            <ImageButton
                android:id="@+id/btnEdit"
                style="@style/Widget.SalesApp.IconButton"
                android:src="@drawable/ic_edit"
                android:contentDescription="Edit" />

            <ImageButton
                android:id="@+id/btnToggle"
                style="@style/Widget.SalesApp.IconButton"
                android:src="@drawable/ic_delete"
                android:contentDescription="Delete" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
